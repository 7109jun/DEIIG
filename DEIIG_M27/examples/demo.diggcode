// DEIIG DIGG Runtime demo
fn add(a, b) {
    return a + b;
}

fn main() {
    let x = 10;
    let y = add(x, 5);

    print("DEIIG DIGG:", y);

    if (y > 10) {
        println("condition works");
    } else {
        println("condition failed");
    }

    let i = 0;
    while (i < 3) {
        println("loop", i);
        i = i + 1;
    }
}
